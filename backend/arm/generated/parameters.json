{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "storageMode": {
            "value": "new"
        },
        "storageAccountName": {
            "value": "armchaist"
        },
        "storageLocation": {
            "value": "eastus"
        },
        "storageKind": {
            "value": "StorageV2"
        },
        "storageSku": {
            "value": "Standard_LRS"
        },
        "accessTier": {
            "value": "Hot"
        },
        "publicNetworkAccess": {
            "value": "Enabled"
        },
        "minimumTlsVersion": {
            "value": "TLS1_2"
        },
        "secureTransferRequired": {
            "value": true
        },
        "allowBlobPublicAccess": {
            "value": false
        },
        "allowSharedKeyAccess": {
            "value": true
        },
        "largeFileSharesState": {
            "value": "Disabled"
        }
    }
}