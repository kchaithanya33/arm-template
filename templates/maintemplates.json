{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",

  "parameters": {

    "storageMode": {
      "type": "string"
    },

    "storageAccountName": {
      "type": "string"
    },

    "storageLocation": {
      "type": "string"
    },

    "storageKind": {
      "type": "string",
      "defaultValue": "StorageV2"
    },

    "storageSku": {
      "type": "string",
      "defaultValue": "Standard_LRS"
    },

    "accessTier": {
      "type": "string",
      "defaultValue": "Hot"
    },

    "publicNetworkAccess": {
      "type": "string",
      "defaultValue": "Enabled"
    },

    "minimumTlsVersion": {
      "type": "string",
      "defaultValue": "TLS1_2"
    },

    "secureTransferRequired": {
      "type": "bool",
      "defaultValue": true
    },

    "allowBlobPublicAccess": {
      "type": "bool",
      "defaultValue": false
    },

    "allowSharedKeyAccess": {
      "type": "bool",
      "defaultValue": true
    },

    "encryptionType": {
      "type": "string",
      "defaultValue": "Microsoft.Storage"
    },

    "largeFileSharesState": {
      "type": "string",
      "defaultValue": "Disabled"
    },

    "existingStorageResourceId": {
      "type": "string",
      "defaultValue": ""
    },

    "existingStorageConnectionString": {
      "type": "string",
      "defaultValue": ""
    },


    "logicAppMode": {
      "type": "string",
      "defaultValue": "new"
    },

    "logicAppName": {
      "type": "string"
    },

    "logicAppLocation": {
      "type": "string"
    },

    "workflowType": {
      "type": "string",
      "defaultValue": "Consumption"
    },


    "applicationInsightsMode": {
      "type": "string",
      "defaultValue": "new"
    },

    "applicationInsightsName": {
      "type": "string"
    },

    "applicationInsightsLocation": {
      "type": "string"
    },

    "applicationType": {
      "type": "string",
      "defaultValue": "web"
    },

    "applicationInsightsRetentionInDays": {
      "type": "int",
      "defaultValue": 90
    },


    "workspaceMode": {
      "type": "string",
      "defaultValue": "new"
    },

    "workspaceName": {
      "type": "string"
    },

    "workspaceLocation": {
      "type": "string"
    },

    "workspaceSku": {
      "type": "string",
      "defaultValue": "PerGB2018"
    }

  },


  "resources": [

    {
      "condition": "[equals(parameters('storageMode'),'new')]",

      "type": "Microsoft.Storage/storageAccounts",

      "apiVersion": "2023-01-01",

      "name": "[parameters('storageAccountName')]",

      "location": "[parameters('storageLocation')]",

      "sku": {
        "name": "[parameters('storageSku')]"
      },

      "kind": "[parameters('storageKind')]",


      "properties": {

        "accessTier": "[parameters('accessTier')]",

        "publicNetworkAccess": "[parameters('publicNetworkAccess')]",

        "minimumTlsVersion": "[parameters('minimumTlsVersion')]",

        "supportsHttpsTrafficOnly": "[parameters('secureTransferRequired')]",

        "allowBlobPublicAccess": "[parameters('allowBlobPublicAccess')]",

        "allowSharedKeyAccess": "[parameters('allowSharedKeyAccess')]",

        "largeFileSharesState": "[parameters('largeFileSharesState')]",


        "encryption": {

          "services": {

            "blob": {
              "enabled": true
            },

            "file": {
              "enabled": true
            }

          },

          "keySource": "[parameters('encryptionType')]"

        }

      }

    },


    {
      "condition": "[equals(parameters('logicAppMode'),'new')]",

      "type": "Microsoft.Logic/workflows",

      "apiVersion": "2019-05-01",

      "name": "[parameters('logicAppName')]",

      "location": "[parameters('logicAppLocation')]",

      "properties": {

        "state": "Enabled",

        "definition": {

          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",

          "contentVersion": "1.0.0.0",

          "parameters": {},

          "triggers": {},

          "actions": {}

        }

      }

    },


    {
      "condition": "[equals(parameters('applicationInsightsMode'),'new')]",

      "type": "Microsoft.Insights/components",

      "apiVersion": "2020-02-02",

      "name": "[parameters('applicationInsightsName')]",

      "location": "[parameters('applicationInsightsLocation')]",

      "kind": "web",

      "properties": {

        "Application_Type": "[parameters('applicationType')]",

        "RetentionInDays": "[parameters('applicationInsightsRetentionInDays')]"

      }

    },


    {
      "condition": "[equals(parameters('workspaceMode'),'new')]",

      "type": "Microsoft.OperationalInsights/workspaces",

      "apiVersion": "2022-10-01",

      "name": "[parameters('workspaceName')]",

      "location": "[parameters('workspaceLocation')]",

      "properties": {

        "sku": {

          "name": "[parameters('workspaceSku')]"

        }

      }

    }

  ]

}